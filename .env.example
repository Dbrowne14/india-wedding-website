# Gift bank details shown in the Gifts section. Copy to .env.local (git-ignored)
# and fill in, and add the same keys in Vercel → Project → Settings → Environment
# Variables. Spaces/dashes are fine; they're stripped from the copied value.
NEXT_PUBLIC_GIFT_ACCOUNT_NAME="Account Name"
NEXT_PUBLIC_GIFT_UK_SORT_CODE="00-00-00"
NEXT_PUBLIC_GIFT_UK_ACCOUNT_NUMBER="00000000"
NEXT_PUBLIC_GIFT_INTL_IBAN="GB00 XXXX 0000 0000 0000 00"
NEXT_PUBLIC_GIFT_INTL_BIC="XXXXGB00"
