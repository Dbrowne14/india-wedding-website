# Gift bank details shown in the Gifts section. Server-only (no NEXT_PUBLIC_
# prefix): read by src/lib/giftDetails.ts and served by /api/gift-details only
# when a guest opens a transfer route. Copy to .env.local (git-ignored) and fill
# in, and add the same keys in Vercel → Project → Settings → Environment
# Variables. Spaces/dashes are fine; they're stripped from the copied value.
GIFT_ACCOUNT_NAME="Account Name"
GIFT_UK_SORT_CODE="00-00-00"
GIFT_UK_ACCOUNT_NUMBER="00000000"
GIFT_INTL_IBAN="GB00 XXXX 0000 0000 0000 00"
GIFT_INTL_BIC="XXXXGB00"
